{
  "name": "kadrokreo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosiopp/kadrokreo.git"
  },
  "homepage": "https://github.com/yosiopp/kadrokreo#readme",
  "bugs": {
    "url": "https://github.com/yosiopp/kadrokreo/issues"
  },
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --mode editor",
    "build": "tsc -b && npm run build:viewer && npm run build:editor",
    "build:viewer": "vite build --outDir dist/viewer",
    "build:editor": "vite build --mode editor --outDir dist/editor",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "capture": "node e2e/run.mjs capture",
    "preview": "vite preview --outDir dist/viewer",
    "preview:editor": "vite preview --outDir dist/editor",
    "kdr": "node cli/kadrokreo.ts",
    "check:viewer": "node scripts/check-viewer.mjs",
    "check:version": "node scripts/version.mjs check",
    "check": "npm test && npm run lint && npm run check:version && npm run build && npm run check:viewer && npm run e2e",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "bin": {
    "kdr": "./cli/kadrokreo.ts",
    "kadrokreo": "./cli/kadrokreo.ts"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.1.0"
  }
}
